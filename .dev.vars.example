# Local secrets for `npm run dev` (wrangler reads .dev.vars). Copy this file to .dev.vars and fill it in.
# .dev.vars is git-ignored. Never commit real values, and never paste them into chat.

# From discogs.com/settings/developers: the DEV application's Consumer Key and Consumer Secret.
# Its callback URL must be exactly: http://localhost:8780/api/discogs/callback
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Any long random string (24+ characters); it encrypts the login cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=
